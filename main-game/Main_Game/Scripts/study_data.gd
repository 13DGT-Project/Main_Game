## Shuffles a question's options and remaps its `correct` index to follow the
## right answer to its new position. The bank stores localisation keys, so the
## question and options are translated here, into whatever language is active
## right now. The shuffle follows indices rather than text, so two options that
## happen to translate to the same word can't confuse which one is correct.
static func shuffle_question(q: Dictionary) -> Dictionary:
	var order: Array = range(q.options.size())
	order.shuffle()
	var options: Array = []
	for i in order:
		options.append(TranslationServer.translate(str(q.options[i])))
	var shuffled: Dictionary = q.duplicate(true)
	shuffled.question = TranslationServer.translate(str(q.question))
	shuffled.options = options
	shuffled.correct = order.find(int(q.correct))
	return shuffled


## Returns `count` random questions for `subject` (no repeats within a session).
func get_session_questions(subject: String, count: int = 5) -> Array:
	if not _banks.has(subject):
		push_warning("StudyData: unknown subject '%s'" % subject)
		return []
	var pool: Array = _banks[subject].duplicate(true)
	pool.shuffle()
	var selected: Array = pool.slice(0, min(count, pool.size()))
	var result: Array = []
	for q in selected:
		result.append(shuffle_question(q))
	return result


## All subject keys this bank supports — useful for building the subject-select UI.
func get_subjects() -> Array:
	return _banks.keys()


## Total question count across all subjects — handy for a debug/sanity check.
func get_total_question_count() -> int:
	var total: int = 0
	for subject in _banks:
		total += _banks[subject].size()
	return total
